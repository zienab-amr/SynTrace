# Copy to .env and set development-only values locally.
SYNTRACE_SQL_PASSWORD=
SYNTRACE_RABBITMQ_PASSWORD=
SYNTRACE_JWT_SIGNING_KEY=

SYNTRACE_API_PORT=8080
SYNTRACE_RABBITMQ_MANAGEMENT_PORT=15672

SYNTRACE_GITHUB_APP_ID=0
SYNTRACE_GITHUB_APP_SLUG=syntrace-integration
SYNTRACE_GITHUB_CLIENT_ID=
SYNTRACE_GITHUB_CLIENT_SECRET=
SYNTRACE_GITHUB_WEBHOOK_SECRET=
SYNTRACE_GITHUB_REDIRECT_URI=
SYNTRACE_GITHUB_FRONTEND_REDIRECT_URI=
# Absolute path to a GitHub App key stored outside the repository.
SYNTRACE_GITHUB_PRIVATE_KEY_FILE=

SYNTRACE_JIRA_CLIENT_ID=
SYNTRACE_JIRA_CLIENT_SECRET=
SYNTRACE_JIRA_REDIRECT_URI=
SYNTRACE_JIRA_WEBHOOK_BASE_URL=
SYNTRACE_JIRA_FRONTEND_REDIRECT_URI=
SYNTRACE_SMTP_EMAIL=
SYNTRACE_SMTP_APP_PASSWORD=

# Example for an AI service running outside Compose on the development host:
# SYNTRACE_AI_BASE_URL=http://host.docker.internal:8000/
SYNTRACE_AI_BASE_URL=
SYNTRACE_AI_API_KEY=
SYNTRACE_AI_PROJECT_SCOPE=false
