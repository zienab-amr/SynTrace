# Copy to .env.local and adjust. Never commit real secrets: anything VITE_* is public in the browser bundle.
VITE_API_URL=http://localhost:8081
# React mount path: "/" locally, "/web/" behind the shared Nginx gateway.
VITE_BASE_PATH=/
# Optional: local-only mock login for isolated UI work; leave commented for real API integration:
# VITE_USE_MOCK_AUTH=true
