# API origin: leave empty for the same-origin gateway or Vite proxy.
# The current team backend is exposed through this ngrok gateway:
# https://jackeline-cibarious-supergallantly.ngrok-free.dev
# Use the origin only; never append /api, /web, /scalar/v1 or a Scalar URL fragment.
VITE_API_URL=

# Local development fallback. .env.development.local points this at the current remote ngrok gateway.
VITE_API_PROXY_TARGET=http://localhost:8081

# React mount path: '/' locally, '/web/' behind the shared Nginx gateway.
VITE_BASE_PATH=/

# Optional local-only mock login for isolated UI work; leave unset for real API integration.
# VITE_USE_MOCK_AUTH=true
