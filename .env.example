# Copy to .env beside the repository-root docker-compose.yml.
# Set local development credentials. Keep .env out of version control.

# ==============================
# Core Backend Configuration
# ==============================

MSSQL_SA_PASSWORD=
RABBITMQ_USER=syntrace
RABBITMQ_PASSWORD=
JWT_KEY=

# ==============================
# Jira Integration
# ==============================

JIRA_OAUTH_CLIENT_SECRET=

# ==============================
# AI Configuration
# ==============================

AI_API_KEY=

# AI service
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# fallback when the main Groq account hits its limit: a second account's key runs the same model
# (or GROQ_FALLBACK_MODEL); without that key, GROQ_FALLBACK_MODEL is another model on the main account
GROQ_FALLBACK_API_KEY=
GROQ_FALLBACK_MODEL=
# Meeting transcripts (optional): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# a second OpenRouter key (another account): used when the main key's 50 free requests a day are used up
OPENROUTER_FALLBACK_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
# times the long-context model reads a meeting: 2 finds more of the points (merged; points one reading found need review), 1 halves the requests
MEETING_READS=2
MEETING_EXTRACT_PROVIDER=openrouter

# ==============================
# Meeting Agent Configuration
# ==============================

# Keep disabled until the new AI meeting contract is deployed and verified.
SYNTRACE_ENABLE_MEETING_CONTRACT=false

SYNTRACE_MEETING_HISTORY_COUNT=20

# Set to 30 together with the upgraded AI to accept and use the longer history.
SYNTRACE_AI_CONVERSATION_TURNS=3

# ==============================
# Web Frontend Configuration
# ==============================

# React uses same-origin API requests
SYNTRACE_REACT_API_URL=

# React deployment path
SYNTRACE_REACT_BASE_PATH=/web/

# Flutter uses same-origin API requests
SYNTRACE_FLUTTER_API_URL=/api

# ==============================
# Gmail SMTP
# ==============================

# Required by the backend container for sign-up and OTP emails.
SYNTRACE_SMTP_EMAIL=
SYNTRACE_SMTP_APP_PASSWORD=

# ==============================
# GitHub App Integration
# ==============================

SYNTRACE_GITHUB_APP_ID=
SYNTRACE_GITHUB_APP_SLUG=
SYNTRACE_GITHUB_CLIENT_ID=
SYNTRACE_GITHUB_CLIENT_SECRET=
SYNTRACE_GITHUB_WEBHOOK_SECRET=
SYNTRACE_GITHUB_REDIRECT_URI=
SYNTRACE_GITHUB_FRONTEND_REDIRECT_URI=

# Required: the path of the GitHub App private key on this machine.
# An empty file works when GitHub is not used.
SYNTRACE_GITHUB_PRIVATE_KEY_FILE=

SYNTRACE_GITHUB_SYNC_ENABLED=false